{
  "root": true,
  "env": { "browser": true, "es2021": true, "node": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "module" },
  "globals": {
    "SocratopiaCore": "readonly",
    "JSZip": "readonly",
    "mammoth": "readonly",
    "pdfjsLib": "readonly"
  },
  "rules": {
    // no-undef 是模块化拆分的护栏：函数搬进子模块后，宿主里残留的裸调用会立刻报错，
    // 而不是等到运行时才 ReferenceError。（原为临时 .eslintrc.audit.json，20260906 固化）
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off",
    "semi": ["warn", "always"],
    "no-trailing-spaces": "warn"
  }
}
